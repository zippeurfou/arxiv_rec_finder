<file path=".github/workflows/daily.yaml">
name: arxiv-bot-daily

on:
  schedule:
    - cron: "0 13 * * *"
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Install uv
        uses: astral-sh/setup-uv@v6

      - name: Sync dependencies
        run: uv sync

      - name: Install Ollama
        run: curl -fsSL https://ollama.com/install.sh | sh

      - name: Start Ollama server
        run: |
          ollama serve &
          # Wait until Ollama is listing models (server ready)
          until ollama list >/dev/null 2>&1; do
            echo "Waiting for Ollama..."
            sleep 1
          done

      - name: Pull deepseek model
        run: ollama pull deepseek-r1:latest

      - name: Run bot
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: uv run python main.py
</file>

<file path="arxiv_client.py">
from urllib.parse import quote_plus

import feedparser


def get_recent_arxiv_papers(query, category, max_results=1000):
    base_url = "http://export.arxiv.org/api/query?"
    safe_query = quote_plus(query)  # encode "a b" → "a+b"
    safe_cat = quote_plus(category)
    q = (
        f"search_query=all:{safe_query}"
        f"+AND+cat:{safe_cat}"
        "&sortBy=submittedDate&sortOrder=descending"
        f"&max_results={max_results}"
    )
    feed = feedparser.parse(base_url + q)
    return feed.entries
